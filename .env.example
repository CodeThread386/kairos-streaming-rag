# Everything works with no configuration. These are only for the optional LLM polish mode.
KAIROS_SYNTHESIS=extractive          # set to "llm" to enable
KAIROS_LLM_BASE_URL=http://localhost:11434/v1   # Ollama; or https://api.openai.com/v1, Gemini's OpenAI endpoint, Groq, vLLM...
KAIROS_LLM_MODEL=qwen2.5:7b-instruct
KAIROS_LLM_API_KEY=                  # never commit keys
KAIROS_PRICE_IN_PER_MTOK=0           # optional, for cost-per-turn telemetry
KAIROS_PRICE_OUT_PER_MTOK=0
KAIROS_CORPUS=corpus/tessera         # any folder of .md/.txt/.html/.pdf/.docx/.json/.jsonl
